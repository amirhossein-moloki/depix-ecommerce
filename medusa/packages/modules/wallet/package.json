{
  "name": "@medusajs/wallet",
  "version": "2.21.2",
  "description": "Medusa Customer Wallet module integration",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "!dist/**/__tests__",
    "!dist/**/__mocks__",
    "!dist/**/__fixtures__"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "watch": "yarn run -T tsc --build --watch",
    "build": "yarn run -T rimraf dist && yarn run -T tsc --build",
    "test": "../../../node_modules/.bin/jest --passWithNoTests --bail --forceExit --testPathPattern=src"
  },
  "dependencies": {
    "@amirhossein-moloki/wallet-core": "workspace:*",
    "@amirhossein-moloki/wallet-persistence-postgres": "workspace:*"
  },
  "devDependencies": {
    "@medusajs/framework": "2.21.2"
  },
  "peerDependencies": {
    "@medusajs/framework": "2.21.2"
  }
}
