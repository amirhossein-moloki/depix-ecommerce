# Depix E-commerce Workspace Environment Variables Example
# DO NOT ADD REAL SECRETS TO THIS FILE.

# General / Server
NODE_ENV=development
NGINX_PORT=80

# PostgreSQL Configuration (Shared PostgreSQL 16 Instance)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=depix_db
POSTGRES_PORT=5432

# Database names for sub-applications
MEDUSA_DB_NAME=medusa_db

# Custom Connection URLs
# Example for internal non-SSL Docker Postgres: postgres://postgres:postgres@postgres:5432/depix_db?sslmode=disable
MEDUSA_DATABASE_URL=

# Redis Configuration (Shared Redis 7 Instance with Logical DB Isolation)
# - Blog Celery/Channels: DB 0 | Blog Cache: DB 1 (Blog appends '/1' automatically to BLOG_REDIS_URL)
# - Medusa Session/Events/Cache: DB 2
REDIS_PORT=6379
MEDUSA_REDIS_URL=redis://redis:6379/2
# IMPORTANT: Do NOT append a '/<db>' suffix to BLOG_REDIS_URL because Blog appends '/1' for CACHES.
BLOG_REDIS_URL=redis://redis:6379

# Medusa Service Configuration
MEDUSA_PORT=9000
MEDUSA_JWT_SECRET=
MEDUSA_COOKIE_SECRET=
DISABLE_MEDUSA_ADMIN=true
# Development OTP Bypass (when true or 1, OTP SMS is bypassed and '00000' can be used to log in)
SKIP_OTP=false

# Blog Service Configuration (Blog Submodule)
# Copy .env.blog.example to .env.blog for Blog-specific secrets & app settings (SECRET_KEY, STATIC_API_KEY, email, S3, etc.)
BLOG_PORT=8000
BLOG_DB_NAME=blog_db
BLOG_DB_USER=blog_user
BLOG_DB_PASSWORD=blog_password
# Optional full connection string override (auto-constructed from BLOG_DB_* when unset)
BLOG_DATABASE_URL=
BLOG_USE_REDIS=True
BLOG_DEBUG=True
BLOG_ALLOWED_HOSTS=localhost,127.0.0.1,blog
BLOG_FORCE_SCRIPT_NAME=/blog
BLOG_STATIC_URL=/blog/static/
BLOG_MEDIA_URL=/blog/media/
BLOG_SECURE_SSL_REDIRECT=False
BLOG_SESSION_COOKIE_SECURE=False
BLOG_CSRF_COOKIE_SECURE=False
BLOG_CSRF_TRUSTED_ORIGINS=http://localhost,http://127.0.0.1,http://localhost:8000,http://localhost:3000
BLOG_CELERY_CONCURRENCY=2

# Notification & SMS Provider Configuration
SMS_PROVIDER=fake
SMS_API_KEY=
SMS_SENDER=
SMS_API_URL=
SMS_TIMEOUT=5000
NOTIFICATION_RETRY_LIMIT=3
SMS_ORDER_NOTIFICATIONS_ENABLED=true
SMS_ENABLE_OTP=true

# Payment Gateway Configuration
PAYMENT_ENV=sandbox
# Frontend application base domain used to construct /payment/success and /payment/failed redirect URLs
# Local example: http://localhost:3000 | Production example: https://example.com
APP_URL=http://localhost:3000
PAYMENT_TIMEOUT_MS=15000

# Mellat Gateway Configuration
MELLAT_TERMINAL_ID=
MELLAT_USERNAME=
MELLAT_PASSWORD=
MELLAT_CALLBACK_URL=

# Zibal Gateway Configuration (sandbox test merchant is 'zibal'; never allowed in production)
ZIBAL_MERCHANT=zibal
ZIBAL_CALLBACK_URL=http://localhost/api/medusa/payment/callback

# Zarinpal Gateway Configuration
ZARINPAL_ACCESS_TOKEN=
ZARINPAL_MERCHANT_ID=
ZARINPAL_CALLBACK_URL=

# Saman Gateway Configuration
SAMAN_TERMINAL_ID=
SAMAN_CALLBACK_URL=
