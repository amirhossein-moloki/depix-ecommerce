# Depix E-commerce Workspace Environment Variables Example
# DO NOT ADD REAL SECRETS TO THIS FILE.

# General / Server
NODE_ENV=development
NGINX_PORT=80

# PostgreSQL Configuration
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=depix_db
POSTGRES_PORT=5432

# Database names for sub-applications
MEDUSA_DB_NAME=medusa_db
PAYLOAD_DB_NAME=payload_db

# Custom Connection URLs
MEDUSA_DATABASE_URL=
PAYLOAD_DATABASE_URL=

# Redis Configuration
REDIS_PORT=6379
REDIS_URL=redis://redis:6379

# Medusa Service Configuration
MEDUSA_PORT=9000
MEDUSA_JWT_SECRET=
MEDUSA_COOKIE_SECRET=

# Notification & SMS Provider Configuration
SMS_PROVIDER=fake
SMS_API_KEY=
SMS_SENDER=
SMS_API_URL=
SMS_TIMEOUT=5000
NOTIFICATION_RETRY_LIMIT=3
SMS_ORDER_NOTIFICATIONS_ENABLED=true
SMS_ENABLE_OTP=true

# Payload Service Configuration
PAYLOAD_PORT=3000
PAYLOAD_SECRET=

# Payment Gateway Configuration (AI-INTEGRATION.md)
PAYMENT_ENV=development

# Mellat Gateway Configuration
MELLAT_TERMINAL_ID=
MELLAT_USERNAME=
MELLAT_PASSWORD=
MELLAT_CALLBACK_URL=

# Zibal Gateway Configuration
ZIBAL_MERCHANT=
ZIBAL_CALLBACK_URL=

# Zarinpal Gateway Configuration
ZARINPAL_ACCESS_TOKEN=
ZARINPAL_MERCHANT_ID=
ZARINPAL_CALLBACK_URL=

# Saman Gateway Configuration
SAMAN_TERMINAL_ID=
SAMAN_CALLBACK_URL=
