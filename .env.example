# Depix E-commerce Workspace Environment Variables Example
# DO NOT ADD REAL SECRETS TO THIS FILE.

# General / Server
NODE_ENV=development
NGINX_PORT=80

# PostgreSQL Configuration
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=depix_db
POSTGRES_PORT=5432

# Database names for sub-applications
MEDUSA_DB_NAME=medusa_db
PAYLOAD_DB_NAME=payload_db

# Custom Connection URLs
MEDUSA_DATABASE_URL=
PAYLOAD_DATABASE_URL=

# Redis Configuration
REDIS_PORT=6379
REDIS_URL=redis://redis:6379

# Medusa Service Configuration
MEDUSA_PORT=9000
MEDUSA_JWT_SECRET=
MEDUSA_COOKIE_SECRET=

# Notification & SMS Provider Configuration (Phase 4)
NOTIFICATION_SMS_PROVIDER=fake
SMS_API_KEY=
SMS_SENDER=
SMS_API_URL=
SMS_TIMEOUT=5000
NOTIFICATION_RETRY_LIMIT=3

# Payload Service Configuration
PAYLOAD_PORT=3000
PAYLOAD_SECRET=
