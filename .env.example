# Depix E-commerce Workspace Environment Variables Example
# DO NOT ADD REAL SECRETS TO THIS FILE.

# General / Server
NODE_ENV=development
NGINX_PORT=80

# PostgreSQL Configuration
POSTGRES_USER=app_user
POSTGRES_PASSWORD=change_this_password
POSTGRES_DB=depix_db
POSTGRES_PORT=5432

# Database names for sub-applications
MEDUSA_DB_NAME=medusa_db
PAYLOAD_DB_NAME=payload_db

# Custom Connection URLs
MEDUSA_DATABASE_URL=postgres://app_user:change_this_password@postgres:5432/medusa_db
PAYLOAD_DATABASE_URL=postgres://app_user:change_this_password@postgres:5432/payload_db

# Redis Configuration
REDIS_PORT=6379
REDIS_URL=redis://redis:6379

# Medusa Service Configuration
MEDUSA_PORT=9000
MEDUSA_JWT_SECRET=change_this_jwt_secret
MEDUSA_COOKIE_SECRET=change_this_cookie_secret

# Payload Service Configuration
PAYLOAD_PORT=3000
PAYLOAD_SECRET=change_this_payload_secret
