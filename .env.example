# Depix E-commerce Workspace Environment Variables Example
# DO NOT ADD REAL SECRETS TO THIS FILE.

# General / Server
NODE_ENV=development
NGINX_PORT=80

# PostgreSQL Configuration
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=depix_db
POSTGRES_PORT=5432

# Database names for sub-applications
MEDUSA_DB_NAME=medusa_db

# Custom Connection URLs
# Example for internal non-SSL Docker Postgres: postgres://postgres:postgres@postgres:5432/depix_db?sslmode=disable
MEDUSA_DATABASE_URL=

# Redis Configuration
REDIS_PORT=6379
REDIS_URL=redis://redis:6379

# Medusa Service Configuration
MEDUSA_PORT=9000
MEDUSA_JWT_SECRET=
MEDUSA_COOKIE_SECRET=
DISABLE_MEDUSA_ADMIN=true
# Development OTP Bypass (when true or 1, OTP SMS is bypassed and '00000' can be used to log in)
SKIP_OTP=false

# Notification & SMS Provider Configuration
SMS_PROVIDER=fake
SMS_API_KEY=
SMS_SENDER=
SMS_API_URL=
SMS_TIMEOUT=5000
NOTIFICATION_RETRY_LIMIT=3
SMS_ORDER_NOTIFICATIONS_ENABLED=true
SMS_ENABLE_OTP=true

# Payment Gateway Configuration
PAYMENT_ENV=sandbox
# Frontend application base domain used to construct /payment/success and /payment/failed redirect URLs
# Local example: http://localhost:3000 | Production example: https://example.com
APP_URL=http://localhost:3000
PAYMENT_TIMEOUT_MS=15000

# Mellat Gateway Configuration
MELLAT_TERMINAL_ID=
MELLAT_USERNAME=
MELLAT_PASSWORD=
MELLAT_CALLBACK_URL=

# Zibal Gateway Configuration (sandbox test merchant is 'zibal'; never allowed in production)
ZIBAL_MERCHANT=zibal
ZIBAL_CALLBACK_URL=http://localhost/api/medusa/payment/callback

# Zarinpal Gateway Configuration
ZARINPAL_ACCESS_TOKEN=
ZARINPAL_MERCHANT_ID=
ZARINPAL_CALLBACK_URL=

# Saman Gateway Configuration
SAMAN_TERMINAL_ID=
SAMAN_CALLBACK_URL=
