# ==============================================================================
# Blog Submodule Application Environment Variables Template (Root Docker Compose)
# ==============================================================================
# Copy this file to '.env.blog' in the workspace root for unified Docker Compose.
# DO NOT add real secrets to this template file.
#
# NOTE: Docker infrastructure & subpath orchestration variables (DATABASE_URL,
# POSTGRES_*, REDIS_URL, USE_REDIS, DEBUG, ALLOWED_HOSTS, FORCE_SCRIPT_NAME,
# STATIC_URL, MEDIA_URL, SECURE_SSL_REDIRECT, SESSION_COOKIE_SECURE,
# CSRF_COOKIE_SECURE, CSRF_TRUSTED_ORIGINS, BACKUP_DIR) are intentionally
# managed by root 'docker-compose.yml' and root '.env' so they are not duplicated
# here.

# ------------------------------------------------------------------------------
# 1. Django Core & Identity Settings
# ------------------------------------------------------------------------------
SECRET_KEY=replace-this-with-a-strong-random-secret-key-in-production
STATIC_API_KEY=replace-this-with-a-secure-static-api-key-min-32-chars
DOMAIN=localhost
SITE_NAME=Blog Platform
FRONTEND_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 2. CORS & Reverse Proxy Header Settings
# ------------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost
CORS_ALLOW_ALL_ORIGINS=False
USE_X_FORWARDED_HOST=True
USE_X_FORWARDED_PORT=True

# ------------------------------------------------------------------------------
# 3. Media, CDN & S3-Compatible Cloud Storage
# ------------------------------------------------------------------------------
USE_CDN=False
CDN_DOMAIN=
STORAGE_BACKEND=local

# S3 Parameters (required when STORAGE_BACKEND=s3 or offsite backup is active)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=us-east-1
AWS_S3_ENDPOINT_URL=
AWS_S3_CUSTOM_DOMAIN=

# ------------------------------------------------------------------------------
# 4. Backup & Disaster Recovery (BDR) Subsystem Settings
# ------------------------------------------------------------------------------
BACKUP_RETENTION_DAYS=7
BACKUP_STORAGE=local
BACKUP_ENCRYPT=False
BACKUP_ENCRYPTION_KEY=change-this-to-a-secure-passphrase-with-high-entropy
BACKUP_OFFSITE_ENABLED=False
BACKUP_OFFSITE_REQUIRED=False

# ------------------------------------------------------------------------------
# 5. Email Configuration
# ------------------------------------------------------------------------------
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=localhost
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=webmaster@localhost

# ------------------------------------------------------------------------------
# 6. Celery Worker & Task Tuning
# ------------------------------------------------------------------------------
CELERY_WORKER_MAX_TASKS_PER_CHILD=100
CELERY_TASK_SOFT_TIME_LIMIT=900
CELERY_TASK_TIME_LIMIT=960
CELERY_VISIBILITY_TIMEOUT=1200
CELERY_RESULT_EXPIRES_HOURS=24
